# ============================================
# Dost AI Backend — Environment Variables
# ============================================
# Copy this file to .env and fill in real values.

# ---------- Django ----------
# SECURITY: Generate a secure random key for production deployments
# (e.g., python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# ---------- Development Overrides (for local development only) ----------
# Uncomment these for local dev:
# SECRET_KEY=your-local-dev-key-here
# DEBUG=True

# ---------- Database ----------
# Local development (uses SQLite by default if DATABASE_URL is not set or commented out):
# DATABASE_URL=sqlite:///db.sqlite3

# Production (PostgreSQL on Neon / Render):
# DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require
DB_SSL_REQUIRE=True
DB_CONN_MAX_AGE=600

# ---------- AI APIs ----------
AI_PROVIDER=gemini
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key

# ---------- CORS ----------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Redis (required in production for WebSockets) ----------
REDIS_URL=redis://localhost:6379/0

# ---------- Error Monitoring (optional) ----------
SENTRY_DSN=
